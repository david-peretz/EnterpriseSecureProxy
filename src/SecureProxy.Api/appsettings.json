{
  "ConnectionStrings": {
    "ProxyDb": "Server=localhost,1433;Database=SecureProxy;User Id=sa;Password=ChangeMe_Str0ng!;TrustServerCertificate=True;Encrypt=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Proxy": {
    "MaxEnvelopeBytes": 1048576,
    "DefaultMaxResponseBytes": 10485760,
    "MaxTimeoutSeconds": 120,
    "ConfigCacheSeconds": 30,
    "NegativeCacheSeconds": 5,
    "CorrelationHeaderName": "X-Correlation-ID",
    "AllowedHttpMethods": [ "GET", "POST", "PUT", "PATCH", "DELETE" ],
    "AllowedDestinationSchemes": [ "https" ],
    "DefaultResponseHeaderAllowlist": [ "Content-Type", "Cache-Control", "ETag", "Last-Modified", "Expires", "Vary", "Content-Language", "Retry-After" ],
    "UserAgent": "EnterpriseSecureProxy/1.0"
  },
  "Audit": {
    "ForwardingPolicy": "Mandatory",
    "RejectionPolicy": "Buffered",
    "BufferCapacity": 10000,
    "FlushBatchSize": 200,
    "FlushIntervalMilliseconds": 500
  },
  "Admin": {
    "HeaderName": "X-Admin-ApiKey",
    "ApiKey": "",
    "PrincipalName": "admin-api-key"
  },
  "Resilience": {
    "RateLimitEnabled": true,
    "RateLimitPermitLimit": 100,
    "RateLimitWindowSeconds": 1,
    "AdminRateLimitPermitPerMinute": 60,
    "MaxConcurrentForwards": 200,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerBreakSeconds": 30,
    "RetrySafeMethodsOnConnectFailure": true
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": false
  },
  "Secrets": {
    "_comment": "Secret values are NOT stored here. Provide them via user-secrets or environment variables, e.g. Secrets__demo-orders-v1=<base64 32 bytes>."
  }
}
